# PostgreSQL is used by Docker Compose. SQLite remains the backend local default.
DATABASE_URL=postgresql+psycopg://influence:influence@localhost:5432/influence
NARRATIVE_ENGINE_ENABLED=true
NARRATIVE_PLANNING_ENABLED=true
NARRATIVE_EXECUTION_ENABLED=false
LEGACY_DECISION_FALLBACK_ENABLED=true
AUTO_GENERATE_DAILY_CHAPTERS=false
